class BaseVendorDriver(ABC):
    @abstractmethod
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]: pass
    
    @abstractmethod
    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]: pass


class CiscoDriver(BaseVendorDriver):
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]:
        cli = [
            f"hostname {model.hostname}",
            "ip domain-name empresa.local",
            "crypto key generate rsa modulus 2048",
            "ip ssh version 2",
            "no ip http server\nno ip http secure-server",
            "service password-encryption",
            "banner motd ^C\n ACCESO RESTRINGIDO - MONITOREADO POR SOC\n^C"
        ]
        if "Disable Discovery" in model.protocols:
            cli.append("no cdp run\nno lldp run")
        return cli

    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for v in model.vlans:
            cli.append(f"vlan {v['id']}\n name {v['name']}")
            if v["is_svi"] and v["svi_ip"]:
                cli.append(f"interface Vlan{v['id']}\n description SVI_{v['name']}")
                cli.append(f" ip address {v['svi_ip']} {v['svi_netmask']}\n no shutdown")
        return cli

    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for iface in model.interfaces:
            cli.append(f"interface {iface.port_name}")
            if iface.role == "L3 Routed":
                cli.append(" no switchport")
                if iface.ip_address:
                    cli.append(f" ip address {iface.ip_address} {iface.netmask}")
            elif iface.role == "Access":
                cli.append(" switchport mode access")
                if iface.assigned_vlan:
                    cli.append(f" switchport access vlan {iface.assigned_vlan}")
                if iface.portfast:
                    cli.append(" spanning-tree portfast")
                if iface.bpdu_guard:
                    cli.append(" spanning-tree bpduguard enable")
            elif iface.role == "Trunk":
                cli.append(" switchport mode trunk")
                if iface.assigned_vlan:
                    cli.append(f" switchport trunk allowed vlan {iface.assigned_vlan}")
            cli.append(" no shutdown")
        return cli

    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.ospf: return []
        cli = [f"router ospf {model.ospf['process_id']}", f" router-id {model.ospf['router_id']}"]
        # Incluir tanto interfaces L3 físicas como redes SVI (Condición 2)
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.network:
                cli.append(f" network {iface.network} {iface.wildcard} area {model.ospf['area']}")
        for svi in model.svi_networks:
            cli.append(f" network {svi['network']} {svi['wildcard']} area {model.ospf['area']}")
        return cli

    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.enable_vpn: return []
        return [
            "crypto ikev2 policy WAN-IKE-POLICY\n proposal aes-cbc-256 sha256 group 14",
            "crypto ikev2 keyring WAN-KEYS\n peer REMOTE-PEER\n  address 203.0.113.2\n  pre-shared-key PskS3cur32026!",
            "crypto ikev2 profile WAN-IKE-PROFILE\n match identity remote address 203.0.113.2\n authentication remote pre-share\n authentication local pre-share\n keyring local WAN-KEYS",
            "crypto ipsec transform-set WAN-TS esp-256-sha256-hmac mode tunnel",
            "crypto ipsec profile WAN-IPSEC-PROFILE\n set transform-set WAN-TS\n set ikev2 profile WAN-IKE-PROFILE",
            "interface Tunnel100\n description WAN_IPSEC_TUNNEL\n ip unnumbered GigabitEthernet0/0/0\n tunnel source GigabitEthernet0/0/0\n tunnel mode ipsec ipv4\n tunnel destination 203.0.113.2\n tunnel protection ipsec profile WAN-IPSEC-PROFILE\n no shutdown"
        ]


class HuaweiDriver(BaseVendorDriver):
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]:
        cli = [
            f"sysname {model.hostname}",
            "undo http server enable",
            "stelnet server enable",
            "aaa\n local-user admin password irreversible-cipher H3u@we1_S3cur3!\n local-user admin service-type ssh\n local-user admin privilege level 15\n q"
        ]
        if "Disable Discovery" in model.protocols:
            cli.append("undo lldp enable")
        return cli

    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for v in model.vlans:
            cli.append(f"vlan {v['id']}\n description {v['name']}\n q")
            if v["is_svi"] and v["svi_ip"]:
                cli.append(f"interface Vlanif{v['id']}\n ip address {v['svi_ip']} {v['svi_netmask']}\n q")
        return cli

    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for iface in model.interfaces:
            cli.append(f"interface {iface.port_name}")
            if iface.role == "L3 Routed":
                cli.append(" undo portswitch")
                if iface.ip_address:
                    cli.append(f" ip address {iface.ip_address} {iface.netmask}")
            elif iface.role == "Access":
                cli.append(" port link-type access")
                if iface.assigned_vlan:
                    cli.append(f" port default vlan {iface.assigned_vlan}")
            elif iface.role == "Trunk":
                cli.append(" port link-type trunk")
                if iface.assigned_vlan:
                    cli.append(f" port trunk allow-pass vlan {iface.assigned_vlan}")
            cli.append(" q")
        return cli

    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.ospf: return []
        cli = [f"ospf {model.ospf['process_id']} router-id {model.ospf['router_id']}", f" area {model.ospf['area']}"]
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.network:
                cli.append(f"  network {iface.network} {iface.wildcard}")
        for svi in model.svi_networks:
            cli.append(f"  network {svi['network']} {svi['wildcard']}")
        cli.append(" q\n q")
        return cli

    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.enable_vpn: return []
        return [
            "ipsec proposal PROPOSAL-1\n esp encryption-algorithm aes-256\n esp authentication-algorithm sha256\n q",
            "ike proposal 1\n encryption-algorithm aes-256\n dh group14\n q",
            "ike peer PEER-1 v1\n ike-proposal 1\n pre-shared-key cipher PskS3cur32026!\n remote-address 203.0.113.2\n q",
            "ipsec policy POLICY-1 10 isakmp\n ike-peer PEER-1\n proposal PROPOSAL-1\n q"
        ]


class FortinetDriver(BaseVendorDriver):
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]:
        return [
            "config system global",
            f'    set hostname "{model.hostname}"',
            "    set admin-ssh-port 22",
            "    set pre-login-banner enable",
            "end"
        ]

    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for v in model.vlans:
            cli.extend([
                "config system interface",
                f"    edit 'vlan{v['id']}'",
                "        set vdom 'root'",
                f"        set vlanid {v['id']}",
                "        set interface 'internal'",
                f"        set ip {v['svi_ip']} {v['svi_netmask']}" if v["is_svi"] and v["svi_ip"] else "",
                "    next",
                "end"
            ])
        return [line for line in cli if line]

    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]:
        cli = ["config system interface"]
        for iface in model.interfaces:
            cli.append(f"    edit '{iface.port_name}'")
            if iface.role == "L3 Routed" and iface.ip_address:
                cli.append(f"        set ip {iface.ip_address} {iface.netmask}")
            cli.append("    next")
        cli.append("end")
        return cli

    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.ospf: return []
        cli = ["config router ospf", f"    set router-id {model.ospf['router_id']}", "    config area"]
        cli.append(f"        edit {model.ospf['area']}\n        next\n    end")
        cli.append("    config network")
        idx = 1
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.network:
                cli.append(f"        edit {idx}\n            set prefix {iface.network}/{iface.prefix}\n            set area {model.ospf['area']}\n        next")
                idx += 1
        for svi in model.svi_networks:
            cli.append(f"        edit {idx}\n            set prefix {svi['network']}/{svi['prefix']}\n            set area {model.ospf['area']}\n        next")
            idx += 1
        cli.append("    end\nend")
        return cli

    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.enable_vpn: return []
        return [
            "config vpn ipsec phase1-interface",
            "    edit 'IPSEC-WAN'",
            "        set interface 'wan1'",
            "        set peertype any",
            "        set net-device disable",
            "        set proposal aes256-sha256",
            "        set remote-gw 203.0.113.2",
            "        set psksecret PskS3cur32026!",
            "    next\nend",
            "config vpn ipsec phase2-interface",
            "    edit 'IPSEC-WAN-P2'",
            "        set phase1name 'IPSEC-WAN'",
            "        set proposal aes256-sha256",
            "    next\nend"
        ]


class MikroTikDriver(BaseVendorDriver):
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]:
        cli = [
            f"/system identity set name={model.hostname}",
            "/ip service set telnet disabled=yes ftp disabled=yes www disabled=yes api disabled=yes"
        ]
        if "Disable Discovery" in model.protocols:
            cli.append("/ip neighbor discovery-settings set discover-interface-list=none")
        return cli

    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for v in model.vlans:
            cli.append(f"/interface vlan add name=VLAN_{v['id']} vlan-id={v['id']} interface=ether1")
            if v["is_svi"] and v["svi_ip"]:
                cli.append(f"/ip address add address={v['svi_ip']}/{v['svi_netmask']} interface=VLAN_{v['id']}")
        return cli

    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.ip_address:
                cli.append(f"/ip address add address={iface.ip_address}/{iface.prefix} interface={iface.port_name}")
        return cli

    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.ospf: return []
        cli = [
            f"/routing ospf instance add name=default-instance router-id={model.ospf['router_id']}",
            f"/routing ospf area add name=area-{model.ospf['area']} area-id={model.ospf['area']} instance=default-instance"
        ]
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.network:
                cli.append(f"/routing ospf network add network={iface.network}/{iface.prefix} area=area-{model.ospf['area']}")
        for svi in model.svi_networks:
            cli.append(f"/routing ospf network add network={svi['network']}/{svi['prefix']} area=area-{model.ospf['area']}")
        return cli

    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.enable_vpn: return []
        return [
            "/ip ipsec proposal add name=VPN-PROP auth-algorithms=sha256 enc-algorithms=aes-256-cbc",
            "/ip ipsec peer add name=PEER-WAN address=203.0.113.2 exchange-mode=ike2 profile=default",
            "/ip ipsec identity add peer=PEER-WAN secret=PskS3cur32026!",
            "/ip ipsec policy add peer=PEER-WAN proposal=VPN-PROP src-address=0.0.0.0/0 dst-address=0.0.0.0/0 tunnel=yes"
        ]

