class VlanItem(BaseModel):
    vlan_id: int = Field(..., ge=1, le=4094)
    vlan_name: str
    is_svi: bool = False
    svi_ip: Optional[str] = ""
    prefix: Optional[int] = 24  # Requerido para cálculo VLSM real por VLAN

class InterfaceConfig(BaseModel):
    port_name: str
    role: str  # "L3 Routed", "Access", "Trunk"
    ip_cidr: Optional[str] = ""
    assigned_vlan: Optional[str] = ""
    portfast: bool = False
    bpdu_guard: bool = False
    port_security: bool = False

class OspfConfig(BaseModel):
    enabled: bool = False
    process_id: int = 1
    area: str = "0.0.0.0"
    router_id: Optional[str] = ""

class NetworkRequest(BaseModel):
    hostname: str
    mgmt_ip: str
    device_type: str  # "Router WAN", "Switch L3", "Switch L2"
    vendor: str       # "Cisco", "Huawei", "Fortinet", "MikroTik"
    port_count: int   # 24, 48
    interface_type: str # "FastEthernet", "GigabitEthernet", "10GigabitEthernet"
    base_ip_cidr: str   # ej: "10.240.0.0/16"
    interfaces: List[InterfaceConfig] = []
    vlans: List[VlanItem] = []
    ospf: Optional[OspfConfig] = None
    protocols: List[str] = []
    enable_vpn: bool = False

    @model_validator(mode='after')
    def validate_network_request(self) -> 'NetworkRequest':
        # Condición 1 & 5: Validación de duplicados y errores en inputs
        port_names = [i.port_name for i in self.interfaces]
        if len(port_names) != len(set(port_names)):
            raise HTTPException(status_code=400, detail="Error de validación: Existen nombres de puertos duplicados en las interfaces.")

        vlan_ids = [v.vlan_id for v in self.vlans]
        if len(vlan_ids) != len(set(vlan_ids)):
            raise HTTPException(status_code=400, detail="Error de validación: Existen IDs de VLAN repetidos.")

        # Recopilar y validar IPs para detectar duplicidades o formatos incorrectos
        ip_registry = []
        try:
            mgmt_obj = ipaddress.ip_address(self.mgmt_ip)
            ip_registry.append(str(mgmt_obj))
        except ValueError:
            raise HTTPException(status_code=400, detail=f"IP de Gestión inválida: {self.mgmt_ip}")

        for iface in self.interfaces:
            if iface.ip_cidr:
                try:
                    iface_ip = str(ipaddress.ip_interface(iface.ip_cidr).ip)
                    if iface_ip in ip_registry:
                        raise HTTPException(status_code=400, detail=f"Error de lógica: Dirección IP duplicada detectada en interfaces: {iface_ip}")
                    ip_registry.append(iface_ip)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"IP/CIDR de interfaz inválido: {iface.ip_cidr}")

        for v in self.vlans:
            if v.is_svi and v.svi_ip:
                try:
                    svi_ip_val = str(ipaddress.ip_interface(v.svi_ip).ip)
                    if svi_ip_val in ip_registry:
                        raise HTTPException(status_code=400, detail=f"Error de lógica: Dirección IP duplicada en SVI/VLAN {v.vlan_id}: {svi_ip_val}")
                    ip_registry.append(svi_ip_val)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"IP SVI inválida para VLAN {v.vlan_id}: {v.svi_ip}")

        # Condición 4: Validación estricta de Roles vs Tipo de Dispositivo
        # "El único que puede cumplir con el rol de Access, Trunk y L3 solo es el Sw Capa 3"
        valid_device_types = ["Router WAN", "Switch L3", "Switch L2"]
        if self.device_type not in valid_device_types:
            raise HTTPException(status_code=400, detail=f"Tipo de dispositivo no soportado: {self.device_type}")

        for iface in self.interfaces:
            if self.device_type == "Router WAN":
                if iface.role in ["Access", "Trunk"]:
                    raise HTTPException(
                        status_code=400, 
                        detail=f"Error de lógica: Un 'Router WAN' no puede tener interfaces con rol '{iface.role}'. Los routers operan exclusivamente en Capa 3 ('L3 Routed')."
                    )
            elif self.device_type == "Switch L2":
                if iface.role == "L3 Routed":
                    raise HTTPException(
                        status_code=400, 
                        detail=f"Error de lógica: Un 'Switch L2' no puede tener interfaces en modo 'L3 Routed'."
                    )
                if self.ospf and self.ospf.enabled:
                    raise HTTPException(status_code=400, detail="Error de lógica: Un Switch L2 no soporta OSPF.")
                if self.enable_vpn:
                    raise HTTPException(status_code=400, detail="Error de lógica: Un Switch L2 no soporta VPN IPsec.")

        return self

