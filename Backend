# FASE 2: NORMALIZACIÓN Y ABSTRACCIÓN INTERMEDIA (IR)
# ===================================================================

class NormalizedInterface:
    def __init__(self, raw: InterfaceConfig):
        self.port_name = raw.port_name
        self.role = raw.role
        self.ip_address = ""
        self.netmask = ""
        self.wildcard = ""
        self.network = ""
        self.prefix = 0
        self.assigned_vlan = raw.assigned_vlan
        self.portfast = raw.portfast
        self.bpdu_guard = raw.bpdu_guard
        self.port_security = raw.port_security

        if raw.role == "L3 Routed" and raw.ip_cidr:
            iface = ipaddress.ip_interface(raw.ip_cidr)
            self.ip_address = str(iface.ip)
            self.netmask = str(iface.netmask)
            self.wildcard = str(ipaddress.IPv4Address(int(iface.network.hostmask)))
            self.network = str(iface.network.network_address)
            self.prefix = iface.network.prefixlen

class NormalizedNetworkModel:
    def __init__(self, payload: NetworkRequest):
        self.hostname = payload.hostname
        self.mgmt_ip = payload.mgmt_ip
        self.device_type = payload.device_type
        self.vendor = payload.vendor
        self.enable_vpn = payload.enable_vpn
        self.protocols = payload.protocols
        self.warnings: List[str] = []

        self.interfaces = [NormalizedInterface(i) for i in payload.interfaces]

        # Sanitizar y estructurar VLANs / SVIs con soporte OSPF (Condición 2)
        self.vlans = []
        self.svi_networks = []
        for v in payload.vlans:
            svi_ip_clean = ""
            svi_netmask = ""
            svi_network = ""
            svi_wildcard = ""
            svi_prefix = v.prefix
            
            if v.is_svi and v.svi_ip:
                svi_iface = ipaddress.ip_interface(v.svi_ip)
                svi_ip_clean = str(svi_iface.ip)
                svi_netmask = str(svi_iface.netmask)
                svi_network = str(svi_iface.network.network_address)
                svi_wildcard = str(ipaddress.IPv4Address(int(svi_iface.network.hostmask)))
                svi_prefix = svi_iface.network.prefixlen
                
                self.svi_networks.append({
                    "network": svi_network,
                    "wildcard": svi_wildcard,
                    "prefix": svi_prefix
                })

            self.vlans.append({
                "id": v.vlan_id,
                "name": v.vlan_name,
                "is_svi": v.is_svi,
                "svi_ip": svi_ip_clean,
                "svi_netmask": svi_netmask,
                "svi_network": svi_network,
                "svi_wildcard": svi_wildcard
            })

        # Sanitizar OSPF
        self.ospf = None
        if payload.ospf and payload.ospf.enabled:
            self.ospf = {
                "process_id": payload.ospf.process_id,
                "area": payload.ospf.area,
                "router_id": payload.ospf.router_id or payload.mgmt_ip
            }

