class VlanItem(BaseModel):
    vlan_id: int = Field(..., ge=1, le=4094)
    vlan_name: str
    is_svi: bool = False
    svi_ip: Optional[str] = ""
    prefix: Optional[int] = 24
    # Nuevos campos específicos para Router WAN (Subinterfaces dot1q)
    router_subint_enabled: bool = False
    router_parent_interface: Optional[str] = ""
    router_subint_ip: Optional[str] = ""

class InterfaceConfig(BaseModel):
    port_name: str
    role: str
    ip_cidr: Optional[str] = ""
    assigned_vlan: Optional[str] = ""
    portfast: bool = False
    bpdu_guard: bool = False
    port_security: bool = False

class OspfConfig(BaseModel):
    enabled: bool = False
    process_id: int = 1
    area: str = "0.0.0.0"
    router_id: Optional[str] = ""

class NetworkRequest(BaseModel):
    hostname: str
    mgmt_ip: str
    device_type: str
    vendor: str
    port_count: int
    interface_type: str
    base_ip_cidr: str
    interfaces: List[InterfaceConfig] = []
    vlans: List[VlanItem] = []
    ospf: Optional[OspfConfig] = None
    protocols: List[str] = []
    enable_vpn: bool = False

    @model_validator(mode='after')
    def validate_network_request(self) -> 'NetworkRequest':
        port_names = [i.port_name for i in self.interfaces]
        if len(port_names) != len(set(port_names)):
            raise HTTPException(status_code=400, detail="Error de validación: Existen nombres de puertos duplicados en las interfaces.")

        vlan_ids = [v.vlan_id for v in self.vlans]
        if len(vlan_ids) != len(set(vlan_ids)):
            raise HTTPException(status_code=400, detail="Error de validación: Existen IDs de VLAN repetidos.")

        ip_registry = []
        try:
            mgmt_obj = ipaddress.ip_address(self.mgmt_ip)
            ip_registry.append(str(mgmt_obj))
        except ValueError:
            raise HTTPException(status_code=400, detail=f"IP de Gestión inválida: {self.mgmt_ip}")

        for iface in self.interfaces:
            if iface.ip_cidr:
                try:
                    iface_ip = str(ipaddress.ip_interface(iface.ip_cidr).ip)
                    if iface_ip in ip_registry:
                        raise HTTPException(status_code=400, detail=f"Error de lógica: Dirección IP duplicada detectada en interfaces: {iface_ip}")
                    ip_registry.append(iface_ip)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"IP/CIDR de interfaz inválido: {iface.ip_cidr}")

        for v in self.vlans:
            if v.is_svi and v.svi_ip:
                try:
                    svi_ip_val = str(ipaddress.ip_interface(v.svi_ip).ip)
                    if svi_ip_val in ip_registry:
                        raise HTTPException(status_code=400, detail=f"Error de lógica: Dirección IP duplicada en SVI/VLAN {v.vlan_id}: {svi_ip_val}")
                    ip_registry.append(svi_ip_val)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"IP SVI inválida para VLAN {v.vlan_id}: {v.svi_ip}")

            # Validar subinterfaz de router si está habilitada
            if v.router_subint_enabled and v.router_subint_ip:
                try:
                    sub_ip_val = str(ipaddress.ip_interface(v.router_subint_ip).ip)
                    if sub_ip_val in ip_registry:
                        raise HTTPException(status_code=400, detail=f"Error de lógica: Dirección IP duplicada en subinterfaz VLAN {v.vlan_id}: {sub_ip_val}")
                    ip_registry.append(sub_ip_val)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"IP de Subinterfaz inválida para VLAN {v.vlan_id}: {v.router_subint_ip}")

        valid_device_types = ["Router WAN", "Switch L3", "Switch L2"]
        if self.device_type not in valid_device_types:
            raise HTTPException(status_code=400, detail=f"Tipo de dispositivo no soportado: {self.device_type}")

        return self

class NormalizedInterface:
    def __init__(self, raw: InterfaceConfig):
        self.port_name = raw.port_name
        self.role = raw.role
        self.ip_address = ""
        self.netmask = ""
        self.wildcard = ""
        self.network = ""
        self.prefix = 0
        self.assigned_vlan = raw.assigned_vlan
        self.portfast = raw.portfast
        self.bpdu_guard = raw.bpdu_guard
        self.port_security = raw.port_security

        if raw.role == "L3 Routed" and raw.ip_cidr:
            iface = ipaddress.ip_interface(raw.ip_cidr)
            self.ip_address = str(iface.ip)
            self.netmask = str(iface.netmask)
            self.wildcard = str(ipaddress.IPv4Address(int(iface.network.hostmask)))
            self.network = str(iface.network.network_address)
            self.prefix = iface.network.prefixlen

class NormalizedNetworkModel:
    def __init__(self, payload: NetworkRequest):
        self.hostname = payload.hostname
        self.mgmt_ip = payload.mgmt_ip
        self.device_type = payload.device_type
        self.vendor = payload.vendor
        self.enable_vpn = payload.enable_vpn
        self.protocols = payload.protocols
        self.warnings: List[str] = []

        self.interfaces = [NormalizedInterface(i) for i in payload.interfaces]

        self.vlans = []
        self.svi_networks = []
        self.router_subinterfaces = []

        for v in payload.vlans:
            svi_ip_clean = ""
            svi_netmask = ""
            svi_network = ""
            svi_wildcard = ""
            svi_prefix = v.prefix
            
            if v.is_svi and v.svi_ip:
                svi_iface = ipaddress.ip_interface(v.svi_ip)
                svi_ip_clean = str(svi_iface.ip)
                svi_netmask = str(svi_iface.netmask)
                svi_network = str(svi_iface.network.network_address)
                svi_wildcard = str(ipaddress.IPv4Address(int(svi_iface.network.hostmask)))
                svi_prefix = svi_iface.network.prefixlen
                
                self.svi_networks.append({
                    "network": svi_network,
                    "wildcard": svi_wildcard,
                    "prefix": svi_prefix
                })

            sub_ip_clean = ""
            sub_netmask = ""
            sub_network = ""
            sub_wildcard = ""
            sub_prefix = v.prefix

            if payload.device_type == "Router WAN" and v.router_subint_enabled and v.router_subint_ip:
                sub_iface = ipaddress.ip_interface(v.router_subint_ip)
                sub_ip_clean = str(sub_iface.ip)
                sub_netmask = str(sub_iface.netmask)
                sub_network = str(sub_iface.network.network_address)
                sub_wildcard = str(ipaddress.IPv4Address(int(sub_iface.network.hostmask)))
                sub_prefix = sub_iface.network.prefixlen

                self.router_subinterfaces.append({
                    "vlan_id": v.vlan_id,
                    "parent_interface": v.router_parent_interface or "GigabitEthernet0/0/0",
                    "sub_ip": sub_ip_clean,
                    "sub_netmask": sub_netmask,
                    "network": sub_network,
                    "wildcard": sub_wildcard,
                    "prefix": sub_prefix
                })
                # Incluir también para OSPF si aplica
                self.svi_networks.append({
                    "network": sub_network,
                    "wildcard": sub_wildcard,
                    "prefix": sub_prefix
                })

            self.vlans.append({
                "id": v.vlan_id,
                "name": v.vlan_name,
                "is_svi": v.is_svi,
                "svi_ip": svi_ip_clean,
                "svi_netmask": svi_netmask,
                "router_subint_enabled": v.router_subint_enabled,
                "router_parent_interface": v.router_parent_interface,
                "router_subint_ip": sub_ip_clean,
                "router_subint_netmask": sub_netmask
            })

        self.ospf = None
        if payload.ospf and payload.ospf.enabled:
            self.ospf = {
                "process_id": payload.ospf.process_id,
                "area": payload.ospf.area,
                "router_id": payload.ospf.router_id or payload.mgmt_ip
            }

class BaseVendorDriver(ABC):
    @abstractmethod
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]: pass
    
    @abstractmethod
    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]: pass

    @abstractmethod
    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]: pass

class CiscoDriver(BaseVendorDriver):
    def generate_hardening(self, model: NormalizedNetworkModel) -> List[str]:
        cli = [
            "enable",
            "configure terminal",
            f"hostname {model.hostname}",
            "ip domain-name empresa.local",
            "crypto key generate rsa",
            "2048",
            "ip ssh version 2",
            "service password-encryption",
        ]
        if model.device_type != "Switch L2":
            cli.insert(4, "no ip http server")
            cli.insert(5, "no ip http secure-server")

        if "Disable Discovery" in model.protocols:
            cli.append("no cdp run")
            cli.append("no lldp run")

        if model.device_type == "Switch L3":
            cli.append("ip routing")

        return cli

    def generate_vlans(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        # Si es Router WAN y tiene subinterfaces configuradas:
        if model.device_type == "Router WAN":
            for sub in model.router_subinterfaces:
                parent = sub["parent_interface"]
                v_id = sub["vlan_id"]
                cli.append(f"interface {parent}.{v_id}")
                cli.append(f" description SUBINT_VLAN_{v_id}")
                # Configuración de encriptación/encapsulamiento previa a poner la dirección IP
                cli.append(f" encapsulation dot1Q {v_id}")
                cli.append(f" ip address {sub['sub_ip']} {sub['sub_netmask']}")
                cli.append(" no shutdown")
                cli.append(" exit")
            return cli

        # Para Switch L2 / L3 se mantiene el comportamiento estándar de VLANs y SVIs
        for v in model.vlans:
            cli.append(f"vlan {v['id']}")
            cli.append(f" name {v['name']}")
            cli.append(" exit")
            if v["is_svi"] and v["svi_ip"]:
                cli.append(f"interface Vlan{v['id']}")
                cli.append(f" description SVI_{v['name']}")
                cli.append(f" ip address {v['svi_ip']} {v['svi_netmask']}")
                cli.append(" no shutdown")
                cli.append(" exit")
        return cli

    def generate_interfaces(self, model: NormalizedNetworkModel) -> List[str]:
        cli = []
        for iface in model.interfaces:
            # Si es Router WAN y esta interfaz física actúa como padre de subinterfaces dot1Q, aseguramos no apagarla (no shutdown)
            cli.append(f"interface {iface.port_name}")
            if iface.role == "L3 Routed":
                if model.device_type == "Switch L3":
                    cli.append(" no switchport")
                if iface.ip_address:
                    cli.append(f" ip address {iface.ip_address} {iface.netmask}")
            elif iface.role == "Access":
                cli.append(" switchport mode access")
                if iface.assigned_vlan:
                    cli.append(f" switchport access vlan {iface.assigned_vlan}")
                if iface.portfast:
                    cli.append(" spanning-tree portfast")
                if iface.bpdu_guard:
                    cli.append(" spanning-tree bpduguard enable")
            elif iface.role == "Trunk":
                cli.append(" switchport mode trunk")
                if iface.assigned_vlan:
                    cli.append(f" switchport trunk allowed vlan {iface.assigned_vlan}")
            cli.append(" no shutdown")
            cli.append(" exit")
        return cli

    def generate_ospf(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.ospf or model.device_type == "Switch L2": 
            return []
        cli = [
            f"router ospf {model.ospf['process_id']}",
            f" router-id {model.ospf['router_id']}"
        ]
        for iface in model.interfaces:
            if iface.role == "L3 Routed" and iface.network:
                cli.append(f" network {iface.network} {iface.wildcard} area {model.ospf['area']}")
        for svi in model.svi_networks:
            cli.append(f" network {svi['network']} {svi['wildcard']} area {model.ospf['area']}")
        cli.append(" exit")
        return cli

    def generate_vpn(self, model: NormalizedNetworkModel) -> List[str]:
        if not model.enable_vpn or model.device_type == "Switch L2": 
            return []
        return [
            "crypto ikev2 policy WAN-IKE-POLICY",
            " proposal aes-cbc-256 sha256 group 14",
            " exit",
            "crypto ikev2 keyring WAN-KEYS",
            " peer REMOTE-PEER",
            "  address 203.0.113.2",
            "  pre-shared-key PskS3cur32026!",
            "  exit",
            " exit",
            "crypto ikev2 profile WAN-IKE-PROFILE",
            " match identity remote address 203.0.113.2",
            " authentication remote pre-share",
            " authentication local pre-share",
            " keyring local WAN-KEYS",
            " exit",
            "crypto ipsec transform-set WAN-TS esp-256-sha256-hmac mode tunnel",
            "crypto ipsec profile WAN-IPSEC-PROFILE",
            " set transform-set WAN-TS",
            " set ikev2 profile WAN-IKE-PROFILE",
            " exit",
            "interface Tunnel100",
            " description WAN_IPSEC_TUNNEL",
            " ip unnumbered GigabitEthernet0/0/0",
            " tunnel source GigabitEthernet0/0/0",
            " tunnel mode ipsec ipv4",
            " tunnel destination 203.0.113.2",
            " tunnel protection ipsec profile WAN-IPSEC-PROFILE",
            " no shutdown",
            " exit"
        ]

