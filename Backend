class DriverFactory:
    _drivers = {
        "Cisco": CiscoDriver(),
        "Huawei": HuaweiDriver(),
        "Fortinet": FortinetDriver(),
        "MikroTik": MikroTikDriver()
    }
    @classmethod
    def get_driver(cls, vendor: str) -> BaseVendorDriver:
        return cls._drivers.get(vendor, CiscoDriver())

def perform_ip_planning(base_cidr: str, vlans: List[VlanItem]):
    try:
        base_network = ipaddress.ip_network(base_cidr, strict=False)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=f"CIDR Base Inválido: {str(e)}")

    planning_results = []
    current_address = base_network.network_address

    for vlan in vlans:
        target_prefix = vlan.prefix if vlan.prefix else 24
        try:
            sub = ipaddress.ip_network(f"{current_address}/{target_prefix}", strict=False)
        except ValueError:
            raise HTTPException(status_code=400, detail=f"No hay suficiente espacio en la red base para la VLAN {vlan.vlan_id}")

        hosts = list(sub.hosts())
        planning_results.append({
            "vlan_id": vlan.vlan_id,
            "vlan_name": vlan.vlan_name,
            "network_ip_cidr": f"{sub.network_address}/{sub.prefixlen}",
            "netmask": str(sub.netmask),
            "wildcard": str(ipaddress.IPv4Address(int(sub.hostmask))),
            "gateway": str(hosts[0]) if hosts else "N/A",
            "dhcp_range": f"{hosts[1]} - {hosts[-1]}" if len(hosts) > 1 else "N/A",
            "broadcast": str(sub.broadcast_address)
        })
        current_address = sub.broadcast_address + 1

    return planning_results

def calculate_bom(vendor: str, device_type: str, port_count: int, enable_vpn: bool, interfaces: List[InterfaceConfig]):
    costs = {"Cisco": 2500, "Huawei": 1500, "Fortinet": 2200, "MikroTik": 450}
    base_cost = costs.get(vendor, 1000)
    port_cost = port_count * 18.5
    active_ports = len([i for i in interfaces if i.role in ["L3 Routed", "Trunk"]])
    sfp_cost = active_ports * 65.0
    licensing_cost = 450.0 if enable_vpn else 0.0

    return {
        "items": [
            {"description": f"Chasis Base {vendor} ({device_type})", "cost_usd": float(base_cost)},
            {"description": f"Densidad de Puertos ({port_count} Puertos)", "cost_usd": port_cost},
            {"description": f"Transceivers SFP/SFP+ ({active_ports} Interfaces Activas)", "cost_usd": sfp_cost},
            {"description": "Licenciamiento de Ciberdefensa / IPsec", "cost_usd": licensing_cost}
        ],
        "total_estimated_usd": base_cost + port_cost + sfp_cost + licensing_cost
    }

@app.post("/api/generate-config")
async def generate_configuration(payload: NetworkRequest):
    model = NormalizedNetworkModel(payload)
    driver = DriverFactory.get_driver(model.vendor)

    cli_blocks = [
        "!===========================================================",
        f"!DISPOSITIVO: {model.hostname} | FABRICANTE: {model.vendor.upper()}",
        f"!TIPO: {model.device_type} | IP GESTION: {model.mgmt_ip}",
        f"!ENGINE VERSION: {VERSION}",
        "!==========================================================="
    ]

    if model.warnings:
        cli_blocks.append("!--- ADVERTENCIAS Y SANITIZACIONES APLICADAS ---")
        for w in model.warnings:
            cli_blocks.append(f"WARNING: {w}")
        cli_blocks.append("!-----------------------------------------------")

    cli_blocks.append("!--- HARDENING BÁSICO & CIBERDEFENSA ---")
    cli_blocks.extend(driver.generate_hardening(model))

    if model.vlans or model.router_subinterfaces:
        cli_blocks.append("!--- SEGMENTACIÓN DE VLANS Y SUBINTERFACES ---")
        cli_blocks.extend(driver.generate_vlans(model))

    if model.interfaces:
        cli_blocks.append("!--- CONFIGURACIÓN DE INTERFACES ---")
        cli_blocks.extend(driver.generate_interfaces(model))

    if model.ospf:
        cli_blocks.append("--- PROTOCOLO DE ENRUTAMIENTO OSPF ---")
        cli_blocks.extend(driver.generate_ospf(model))

    if model.enable_vpn:
        cli_blocks.append("!--- TÚNEL IPSEC VPN & SEGURIDAD WAN ---")
        cli_blocks.extend(driver.generate_vpn(model))

    ip_planning_data = perform_ip_planning(payload.base_ip_cidr, payload.vlans)
    bom_data = calculate_bom(payload.vendor, payload.device_type, payload.port_count, payload.enable_vpn, payload.interfaces)

    return {
        "version": VERSION,
        "hostname": model.hostname,
        "warnings": model.warnings,
        "ip_planning": ip_planning_data,
        "cli_script": "\n".join(cli_blocks),
        "bill_of_materials": bom_data
    }

