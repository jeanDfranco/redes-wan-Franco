    function removeDevice(nodeId) {
        const node = activeTopology.nodes.find(n => n.id === nodeId);
        if(node && node.isLocal) { alert("No puede eliminar el dispositivo base (Equipo Local) de la topología."); return; }
        activeTopology.links = activeTopology.links.filter(l => l.source !== nodeId && l.target !== nodeId);
        activeTopology.nodes = activeTopology.nodes.filter(n => n.id !== nodeId);
        renderTopology();
    }
    function getUsedPorts(nodeId) {
        let ports = [];
        activeTopology.links.forEach(l => {
            if (l.source === nodeId) ports.push(l.srcPort);
            if (l.target === nodeId) ports.push(l.dstPort);
        });
        return ports;
    }
    function updateTopoPortSelectors() {
        const srcNodeId = document.getElementById('link-src-node').value;
        const dstNodeId = document.getElementById('link-dst-node').value;
        const srcNode = activeTopology.nodes.find(n => n.id === srcNodeId);
        const dstNode = activeTopology.nodes.find(n => n.id === dstNodeId);
        const srcPortSel = document.getElementById('link-src-port');
        const dstPortSel = document.getElementById('link-dst-port');
        srcPortSel.innerHTML = ''; dstPortSel.innerHTML = '';
        if (srcNode) {
            const used = getUsedPorts(srcNode.id);
            let pList = srcNode.portsList || generateDefaultPorts(srcNode.maxPorts);
            pList.forEach(pname => { if (!used.includes(pname)) srcPortSel.innerHTML += `<option value="${pname}">${pname}</option>`; });
        }
        if (dstNode) {
            const used = getUsedPorts(dstNode.id);
            let pList = dstNode.portsList || generateDefaultPorts(dstNode.maxPorts);
            pList.forEach(pname => { if (!used.includes(pname)) dstPortSel.innerHTML += `<option value="${pname}">${pname}</option>`; });
        }
    }
    function createDeviceLink() {
        const srcNodeId = document.getElementById('link-src-node').value;
        const dstNodeId = document.getElementById('link-dst-node').value;
        const srcPort = document.getElementById('link-src-port').value;
        const dstPort = document.getElementById('link-dst-port').value;
        if (!srcNodeId || !dstNodeId) { alert("Debe tener al menos dos dispositivos en la topología."); return; }
        if (srcNodeId === dstNodeId) { alert("No puede agregar una conexión de un equipo hacia sí mismo."); return; }
        if (!srcPort || !dstPort) { alert("Uno de los dispositivos no tiene puertos libres suficientes."); return; }
        activeTopology.links.push({ id: "LINK-" + Date.now(), source: srcNodeId, srcPort: srcPort, target: dstNodeId, dstPort: dstPort });
        renderTopology();
    }
    function removeLink(linkId) {
        activeTopology.links = activeTopology.links.filter(l => l.id !== linkId);
        renderTopology();
    }
    function renderTopology() {
        renderSVG();
        updateNodeSelectors();
        updateSummaryTables();
    }
    function renderSVG() {
        const svg = document.getElementById('topo-svg');
        if(!svg) return;
        svg.innerHTML = '';
        if (activeTopology.nodes.length === 0) {
            svg.innerHTML = '<text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#94a3b8">Agregue dispositivos o cargue un JSON para visualizar el diagrama</text>';
            return;
        }
        activeTopology.links.forEach(link => {
            const src = activeTopology.nodes.find(n => n.id === link.source);
            const dst = activeTopology.nodes.find(n => n.id === link.target);
            if (src && dst) {
                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute("x1", src.x); line.setAttribute("y1", src.y);
                line.setAttribute("x2", dst.x); line.setAttribute("y2", dst.y);
                line.setAttribute("stroke", "#38bdf8"); line.setAttribute("stroke-width", "2.5");
                svg.appendChild(line);
                const midX = (src.x + dst.x) / 2;
                const midY = (src.y + dst.y) / 2 - 8;
                const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                text.setAttribute("x", midX); text.setAttribute("y", midY);
                text.setAttribute("fill", "#94a3b8"); text.setAttribute("font-size", "10");
                text.setAttribute("text-anchor", "middle");
                text.textContent = `${link.srcPort} ↔ ${link.dstPort}`;
                svg.appendChild(text);
            }
        });
        activeTopology.nodes.forEach(node => {
            const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            circle.setAttribute("cx", node.x); circle.setAttribute("cy", node.y); circle.setAttribute("r", "22");
            circle.setAttribute("fill", node.type === "Router WAN" ? "#22c55e" : "#0369a1");
            circle.setAttribute("stroke", node.isLocal ? "#facc15" : "#f8fafc"); 
            circle.setAttribute("stroke-width", node.isLocal ? "3" : "1.5");
            svg.appendChild(circle);
            const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
            text.setAttribute("x", node.x); text.setAttribute("y", node.y + 38);
            text.setAttribute("fill", "#f8fafc"); text.setAttribute("font-size", "11");
            text.setAttribute("font-weight", "bold");
            text.setAttribute("text-anchor", "middle"); 
            text.textContent = node.name + (node.isLocal ? " (Local)" : "");
            svg.appendChild(text);
        });
    }
    function updateNodeSelectors() {
        const srcSel = document.getElementById('link-src-node');
        const dstSel = document.getElementById('link-dst-node');
        if(!srcSel || !dstSel) return;
        const curSrc = srcSel.value; const curDst = dstSel.value;
        srcSel.innerHTML = ''; dstSel.innerHTML = '';
        activeTopology.nodes.forEach(n => {
            srcSel.innerHTML += `<option value="${n.id}" ${(n.id === curSrc) ? 'selected' : ''}>${n.name} (${n.type})</option>`;
            dstSel.innerHTML += `<option value="${n.id}" ${(n.id === curDst) ? 'selected' : ''}>${n.name} (${n.type})</option>`;
        });
        if(activeTopology.nodes.length > 1 && srcSel.value === dstSel.value) dstSel.selectedIndex = 1;
        updateTopoPortSelectors();
    }
    function updateSummaryTables() {
        const nTbody = document.querySelectorAll('#nodes-summary-table tbody')[0];
        if(nTbody) {
            nTbody.innerHTML = '';
            activeTopology.nodes.forEach(node => {
                const usedCount = getUsedPorts(node.id).length;
                let totalCap = node.portsList ? node.portsList.length : node.maxPorts;
                const delBtn = node.isLocal ? `<span style="color:#94a3b8; font-size:0.8rem;">(Equipo Base)</span>` : `<button type="button" class="btn-danger" style="padding:4px 8px;" onclick="removeDevice('${node.id}')">X Eliminar</button>`;
                nTbody.innerHTML += `
                    <tr>
                        <td><strong>${node.name}</strong></td>
                        <td>${node.type}</td>
                        <td>${totalCap} Puertos</td>
                        <td><span style="color:${usedCount >= totalCap ? 'var(--danger)' : 'var(--accent)'}">${usedCount}</span></td>
                        <td><span style="color:var(--success)">${totalCap - usedCount}</span></td>
                        <td>${delBtn}</td>
                    </tr>
                `;
            });
        }
        const lTbody = document.querySelectorAll('#links-summary-table tbody')[0];
        if(lTbody) {
            lTbody.innerHTML = '';
            if (activeTopology.links.length === 0) { lTbody.innerHTML = '<tr><td colspan="3" style="text-align:center;">Sin enlaces activos.</td></tr>'; return; }
            activeTopology.links.forEach(l => {
                const src = activeTopology.nodes.find(n => n.id === l.source);
                const dst = activeTopology.nodes.find(n => n.id === l.target);
                lTbody.innerHTML += `
                    <tr>
                        <td>${src ? src.name : l.source} (<strong>${l.srcPort}</strong>)</td>
                        <td>${dst ? dst.name : l.target} (<strong>${l.dstPort}</strong>)</td>
                        <td><button type="button" class="btn-danger" onclick="removeLink('${l.id}')">Eliminar Enlace</button></td>
                    </tr>
                `;
            });
        }
    }
    function loadTopologyFromFile(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                activeTopology = JSON.parse(e.target.result);
                if(!activeTopology.nodes || !activeTopology.links) throw new Error("JSON Inválido");
                renderTopology();
                alert('Topología cargada con éxito.');
            } catch (err) { alert('Error al leer el archivo JSON.'); }
        };
        reader.readAsText(file);
    }
