    function generateDefaultPorts(count) {
        let p = [];
        for(let i=0; i<Math.min(count, 2); i++) p.push(`GigabitEthernet0/${i}`);
        for(let i=1; i<=Math.max(0, count-2); i++) p.push(`FastEthernet0/${i}`);
        return p;
    }

    function openAddDeviceModal() { document.getElementById('device-modal').classList.remove('hidden'); }
