    function handleIfRoleChange(select) {
        const row = select.closest('tr');
        const ipInput = row.querySelector('.if-ip-field');
        const vlanSelect = row.querySelector('.if-vlan-field');
        const trunkOpts = row.querySelector('.trunk-vlan-options');
