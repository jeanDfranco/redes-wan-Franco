        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(activeTopology, null, 2));
        const link = document.createElement('a'); link.setAttribute("href", dataStr); link.setAttribute("download", "wan_topology_config.json");
        document.body.appendChild(link); link.click(); link.remove();
    }
    function clearTopology() { 
        const localNode = activeTopology.nodes.find(n => n.isLocal);
        activeTopology = { nodes: localNode ? [localNode] : [], links: [] }; 
        renderTopology(); 
    }

    async function processEngine() {
        const vlans = [];
        document.querySelectorAll('#vlan-table tbody tr').forEach(row => {
            vlans.push({
                vlan_id: parseInt(row.querySelector('.v-id').value),
                vlan_name: row.querySelector('.v-name').value,
                is_svi: row.querySelector('.v-svi-cb') ? row.querySelector('.v-svi-cb').checked : false,
                svi_ip: row.querySelector('.v-svi-ip') ? row.querySelector('.v-svi-ip').value : "",
                router_subint_enabled: row.querySelector('.r-sub-cb') ? row.querySelector('.r-sub-cb').checked : false,
                router_parent_interface: row.querySelector('.r-parent-if') ? row.querySelector('.r-parent-if').value : "",
                router_subint_ip: row.querySelector('.r-sub-ip') ? row.querySelector('.r-sub-ip').value : ""
            });
        });

        const interfaces = [];
        document.querySelectorAll('#interfaces-table tbody tr').forEach(row => {
            const role = row.querySelector('.if-mode').value;
            let assigned = "";
            if (role === 'Access') {
                assigned = row.querySelector('.if-vlan-field').value;
            } else if (role === 'Trunk') {
                const tMode = row.querySelector('.trunk-mode-sel').value;
                if (tMode === 'all') {
                    assigned = "all";
                } else {
                    assigned = row.querySelector('.trunk-specific-vlans').value;
                }
            }
            
            interfaces.push({
                port_name: row.querySelector('.if-name').value,
                role: role,
                ip_cidr: role === 'L3 Routed' ? row.querySelector('.if-ip-field').value : "",
                assigned_vlan: assigned,
                portfast: row.querySelector('.if-pf').checked,
                bpdu_guard: row.querySelector('.if-bpdu').checked
            });
        });

        let totalPorts = 0;
        document.querySelectorAll('#hardware-modules-table tbody tr').forEach(row => { totalPorts += parseInt(row.querySelector('.mod-count').value) || 0; });

        const payload = {
            hostname: document.getElementById('hostname').value,
            mgmt_ip: document.getElementById('mgmt_ip').value,
            device_type: document.getElementById('device_type').value,
            vendor: document.getElementById('vendor').value,
            port_count: totalPorts,
            interface_type: "GigabitEthernet",
            base_ip_cidr: document.getElementById('base_ip_cidr').value,
            interfaces: interfaces,
            vlans: vlans,
            
            enable_vpn: document.getElementById('enable_vpn') ? document.getElementById('enable_vpn').checked : false,
            enable_dhcp_snooping: document.getElementById('chk_dhcp') ? document.getElementById('chk_dhcp').checked : false,
            enable_dai: document.getElementById('chk_dai') ? document.getElementById('chk_dai').checked : false,
            disable_discovery: document.getElementById('chk_cdp') ? document.getElementById('chk_cdp').checked : false,
            
            ospf: (document.getElementById('chk_ospf') && document.getElementById('chk_ospf').checked) ? {
                enabled: true, process_id: 1, area: "0.0.0.0", router_id: document.getElementById('mgmt_ip').value
            } : null,
            topology: activeTopology
        };

        document.getElementById('cli-output').textContent = "Solicitando generación al API...";
        document.getElementById('btn-copy').disabled = true;
        document.getElementById('btn-download').disabled = true;

        try {
            const response = await fetch('http://localhost:8000/api/generate-config', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (!response.ok) {
                const err = await response.json(); alert('Error: ' + err.detail);
                document.getElementById('cli-output').textContent = "! Error al conectar con el backend: " + err.detail;
                return;
            }
            const data = await response.json();

            const ipTbody = document.querySelectorAll('#output-ip-table tbody')[0];
            if (ipTbody && data.ip_planning) {
                ipTbody.innerHTML = '';
                data.ip_planning.forEach(item => {
                    ipTbody.innerHTML += `<tr><td><strong>${item.vlan_id}</strong></td><td>${item.vlan_name}</td><td>${item.network_ip_cidr}</td><td>${item.netmask}</td><td>${item.wildcard}</td><td>${item.gateway}</td><td>${item.dhcp_range}</td><td>${item.broadcast}</td></tr>`;
                });
            }

            const bomContainer = document.getElementById('bom-output');
            if (bomContainer && data.bill_of_materials) {
                let bomHtml = '<ul>';
                data.bill_of_materials.items.forEach(i => { bomHtml += `<li>${i.description}: <strong>$${i.cost_usd.toFixed(2)} USD</strong></li>`; });
                bomHtml += `</ul><div style="border-top:1px solid var(--border); padding-top:5px; margin-top:5px;"><strong>TOTAL ESTIMADO: $${data.bill_of_materials.total_estimated_usd.toFixed(2)} USD</strong></div>`;
                bomContainer.innerHTML = bomHtml;
            }

            if (data.cli_script) {
                document.getElementById('cli-output').textContent = data.cli_script;
                document.getElementById('btn-copy').disabled = false;
                document.getElementById('btn-download').disabled = false;
            }
        } catch (error) {
            document.getElementById('cli-output').textContent = "! Error al conectar con el backend: " + error.message;
            console.error("API Fetch Error:", error);
        }
    }

    function downloadCliFile() {
        const cliText = document.getElementById('cli-output').textContent;
        const hostname = document.getElementById('hostname').value || 'config';
        const vendor = document.getElementById('vendor').value;
        const blob = new Blob([cliText], { type: 'text/plain;charset=utf-8' });
        const link = document.createElement('a'); link.download = `${hostname}_${vendor}_config.txt`;
        link.href = URL.createObjectURL(blob); link.click();
    }
</script>
</body>
