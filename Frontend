<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Engine de Redes WAN & Ciberdefensa - v3.9 Enterprise Modular + Topología</title>
    <script type="text/javascript" src="https://me.kis.v2.scr.kaspersky-labs.com/FD126C42-EBFA-4E12-B309-BB3FDD723AC1/main.js?attr=VOb5VK1Bcp_whrN5ds2NUoRiEiRMosVYBKMO40ofj4cBQNvVO1M_U6gbrqSS-6YyDKwl4PYrg0VZevZdBj25n-7k9keSRY5bobFKHdul_hiMCcU67kIYzkdNGQ5SRd0SBxJV_mqHeyAf3ELyHSC-xII9jSKEMHY_HgTf0cjZWAojbvR-GpYIqpo26CcF0GGb8Py_i3vkVHVhWVWd2ITL0ohGXPTroUnYIBjBfjTcqfuTJncCREuA3fbPCbuZIML_tjDWYbIBfQymwAO22w1D7TqrkUizW5pqxW4OEmOHixHzSOfKuCboPwpXqZYu_4J5ewuksjkvlHNpdexrq_CY7g" charset="UTF-8"></script><link rel="stylesheet" crossorigin="anonymous" href="https://me.kis.v2.scr.kaspersky-labs.com/E3E8934C-235A-4B0E-825A-35A08381A191/abn/main.css?"/><style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: #1e293b;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
            --success: #22c55e;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --danger: #ef4444;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        header {
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 2px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;
        }

        .version-tag { background-color: #0369a1; padding: 4px 12px; border-radius: 12px; font-size: 0.85rem; font-weight: bold; }

        .nav-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
        .tab-btn {
            padding: 10px 20px; background-color: var(--panel-bg); border: 1px solid var(--border);
            border-bottom: none; color: var(--text-muted); font-weight: bold; cursor: pointer; border-radius: 6px 6px 0 0;
        }
        .tab-btn.active { background-color: var(--accent); color: #000; }

        .tab-content { display: none; }
        .tab-content.active { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

        .card { background-color: var(--panel-bg); border-radius: 8px; padding: 20px; border: 1px solid var(--border); }
        h2 { margin-top: 0; color: var(--accent); font-size: 1.15rem; border-bottom: 1px solid var(--border); padding-bottom: 8px; }

        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 5px; }

        input[type="text"], input[type="number"], select {
            width: 100%; padding: 8px 12px; border-radius: 4px; border: 1px solid var(--border);
            background-color: #0f172a; color: var(--text-main); box-sizing: border-box;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
        .grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; }

        .checkbox-group { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 8px; }
        .checkbox-item { display: flex; align-items: center; font-size: 0.85rem; gap: 5px; }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid var(--border); padding: 8px; text-align: left; font-size: 0.82rem; }
        th { background-color: #0f172a; }

        .btn { background-color: var(--accent); color: #000; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 15px; }
        .btn:hover { background-color: var(--accent-hover); color: #fff; }
        .btn-action { width: auto; padding: 6px 12px; font-size: 0.8rem; margin-top: 0; display: inline-flex; align-items: center; gap: 5px; }
        .btn-success { background-color: var(--success); color: #000; }
        .btn-danger { background-color: var(--danger); color: #fff; padding: 4px 8px; }

        .cli-header { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; margin-bottom: 5px; }
        pre { background-color: #090d16; padding: 12px; border-radius: 4px; border: 1px solid var(--border); overflow-x: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.8rem; color: #4ade80; max-height: 380px; white-space: pre-wrap; }

        .hidden { display: none !important; }
        #topology-canvas { width: 100%; height: 320px; background-color: #0f172a; border: 1px dashed var(--border); border-radius: 4px; margin-top: 15px;}
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.8); display: flex; justify-content: center; align-items: center; z-index: 1000; }
        .modal-body { background-color: var(--panel-bg); border: 1px solid var(--border); border-radius: 8px; padding: 25px; width: 420px; }
        .sub-panel { background: #0f172a; padding: 12px; border-radius: 6px; border: 1px solid var(--border); margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>WAN Network Design & IaC Engine</h1>
        <span class="version-tag">Versión: 3.9 Enterprise Modular + Topología Dinámica</span>
    </header>

    <div class="nav-tabs">
        <button class="tab-btn active" onclick="switchTab('config-tab')">1. Configuración Individual de Equipo</button>
        <button class="tab-btn" onclick="switchTab('topology-tab')">2. Topología de Red e Interconexiones</button>
    </div>

    <div id="config-tab" class="tab-content active">
        <div class="card">
            <h2>1. Parámetros Globales y Módulos de Hardware</h2>
            <form id="iac-form">
                
                <div class="form-group sub-panel">
                    <label><strong>Superred / Base CIDR Direccionamiento Global</strong></label>
                    <input type="text" id="base_ip_cidr" value="10.240.0.0/16" required placeholder="ej: 10.240.0.0/16">
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Hostname</label>
                        <input type="text" id="hostname" value="RTR-CORE-01" required onchange="updateLocalNodeName()">
                    </div>
                    <div class="form-group">
                        <label>IP Gestión (Management)</label>
                        <input type="text" id="mgmt_ip" value="10.240.0.1" required>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Tipo de Dispositivo</label>
                        <select id="device_type" onchange="handleDeviceTypeChange()">
                            <option value="Router WAN" selected>Router WAN (L3)</option>
                            <option value="Switch L3">Switch Capa 3</option>
                            <option value="Switch L2">Switch Capa 2</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Fabricante Target</label>
                        <select id="vendor">
                            <option value="Cisco">Cisco IOS-XE</option>
                            <option value="Huawei">Huawei VRP</option>
                            <option value="Fortinet">Fortinet FortiOS</option>
                            <option value="MikroTik">MikroTik RouterOS</option>
                        </select>
                    </div>
                </div>

                <div class="form-group sub-panel">
                    <label><strong>Módulos de Interfaces de Hardware (Chasis / Tarjetas)</strong></label>
                    <table id="hardware-modules-table">
                        <thead>
                            <tr>
                                <th>Tipo de Interfaz</th>
                                <th>Cantidad de Puertos</th>
                                <th>Formato / Slot ID</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <select class="mod-type" onchange="refreshAllInterfaceDropdowns()">
                                        <option value="GigabitEthernet" selected>GigabitEthernet</option>
                                        <option value="FastEthernet">FastEthernet</option>
                                        <option value="10GigabitEthernet">10GigabitEthernet</option>
                                    </select>
                                </td>
                                <td><input type="number" value="2" min="1" max="48" class="mod-count" onchange="refreshAllInterfaceDropdowns()"></td>
                                <td>
                                    <select class="mod-format" onchange="refreshAllInterfaceDropdowns()">
                                        <option value="slot_0">Slot Fijo / Base (0/X)</option>
                                        <option value="slot_0_0">Slot Modular (0/0/X)</option>
                                        <option value="slot_custom">Slot Tarjeta (0/Y/X)</option>
                                    </select>
                                </td>
                                <td><button type="button" class="btn-danger" onclick="removeModuleRow(this)">X</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" class="btn" style="background:#334155; color:#fff; padding:6px; margin-top:8px;" onclick="addHardwareModuleRow()">+ Agregar Módulo de Interfaces</button>
                </div>

                <div class="form-group">
                    <label id="vlan-section-label">VLANs y Configuración de Interfaz Virtual SVI</label>
                    <table id="vlan-table">
                        <thead>
                            <tr>
                                <th>VLAN ID</th>
                                <th>Nombre</th>
                                <th class="col-switch-mode">¿Requiere SVI?</th>
                                <th class="col-switch-mode">IP SVI / CIDR</th>
                                <th class="col-router-mode hidden">Subinterfaz Router (Dot1Q)</th>
                                <th class="col-router-mode hidden">Interfaz Base</th>
                                <th class="col-router-mode hidden">IP Subinterfaz</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="number" value="10" class="v-id" onchange="refreshVlanDropdowns()"></td>
                                <td><input type="text" value="CORP_WAN" class="v-name" onchange="refreshVlanDropdowns()"></td>
                                <td style="text-align:center;" class="col-switch-mode"><input type="checkbox" class="v-svi-cb" onchange="toggleSviInput(this)"></td>
                                <td class="col-switch-mode"><input type="text" value="10.240.10.1/24" class="v-svi-ip" disabled></td>
                                <td style="text-align:center;" class="col-router-mode hidden"><input type="checkbox" class="r-sub-cb" onchange="toggleRouterSubintInputs(this)" checked></td>
                                <td class="col-router-mode hidden"><select class="r-parent-if"><option value="">-- Seleccionar --</option></select></td>
                                <td class="col-router-mode hidden"><input type="text" value="10.240.10.1/24" class="r-sub-ip"></td>
                                <td><button type="button" class="btn-danger" onclick="removeVlanRow(this)">X</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" class="btn" style="background:#334155; color:#fff; padding:5px; margin-top:5px;" onclick="addVlanRow()">+ Añadir VLAN / Subinterfaz</button>
                </div>

                <div class="form-group">
                    <label>Asignación de Interfaces y Direccionamiento IP</label>
                    <table id="interfaces-table">
                        <thead>
                            <tr>
                                <th>Puerto</th>
                                <th>Rol / Modo</th>
                                <th>Configuración IP / VLAN</th>
                                <th class="l2-security-col">Seguridad L2</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><select class="if-name"></select></td>
                                <td>
                                    <select class="if-mode" onchange="handleIfRoleChange(this)">
                                        <option value="L3 Routed">L3 Routed</option>
                                        <option value="Access">Access (L2)</option>
                                        <option value="Trunk">Trunk (L2)</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" value="10.240.1.1/30" class="if-ip-field">
                                    <select class="if-vlan-field hidden"></select>
                                    <div class="trunk-vlan-options hidden" style="display:flex; flex-direction:column; gap:5px;">
                                        <select class="trunk-mode-sel" onchange="handleTrunkModeChange(this)">
                                            <option value="all">Permitir Todas</option>
                                            <option value="specific">VLANs Específicas</option>
                                        </select>
                                        <input type="text" class="trunk-specific-vlans hidden" placeholder="Ej: 10,20,30">
                                    </div>
                                </td>
                                <td class="l2-security-col">
                                    <div class="checkbox-group" style="grid-template-columns:1fr 1fr;">
                                        <label style="font-size:0.75rem;"><input type="checkbox" class="if-pf"> PortFast</label>
                                        <label style="font-size:0.75rem;"><input type="checkbox" class="if-bpdu"> BPDUGuard</label>
                                    </div>
                                </td>
                                <td><button type="button" class="btn-danger" onclick="removeRow(this)">X</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" class="btn" style="background:#334155; color:#fff; padding:5px; margin-top:5px;" onclick="addInterfaceRow()">+ Agregar Interfaz</button>
                </div>

                <div class="form-group sub-panel" style="margin-top:15px;">
                    <label style="margin-bottom: 10px; font-weight: bold; color: var(--text-main); font-size: 1rem;">Políticas de Seguridad y Enrutamiento</label>
                    <div class="grid-2" style="margin-bottom: 10px;">
                        <div class="checkbox-item policy-ospf"><input type="checkbox" id="chk_ospf" checked> OSPF</div>
                        <div class="checkbox-item policy-dhcp"><input type="checkbox" id="chk_dhcp"> DHCP Snooping</div>
                        <div class="checkbox-item policy-dai"><input type="checkbox" id="chk_dai"> Dynamic ARP Insp.</div>
                        <div class="checkbox-item policy-cdp"><input type="checkbox" id="chk_cdp"> Deshabilitar CDP/LLDP</div>
                    </div>
                    <div class="checkbox-item policy-vpn"><input type="checkbox" id="enable_vpn"> Habilitar IPsec VPN (Ciberdefensa WAN)</div>
                    <p style="font-size: 0.75rem; color: var(--accent); margin-top: 10px; margin-bottom: 0;">* Nota: Las opciones se adaptan dinámicamente según el tipo de equipo seleccionado.</p>
                </div>

                <button type="button" class="btn" onclick="processEngine()">Generar Script CLI & Plan IP</button>
            </form>
        </div>

        <div class="card">
            <h2>Resultados e IaC Output</h2>
            <label>IP Planning Calculado (VLSM):</label>
            <div style="overflow-x:auto;">
                <table id="output-ip-table">
                    <thead>
                        <tr>
                            <th>VLAN ID</th>
                            <th>Nombre</th>
                            <th>Subred (CIDR)</th>
                            <th>Máscara Decimal</th>
                            <th>Wildcard</th>
                            <th>Gateway</th>
                            <th>Rango Asignable</th>
                            <th>Broadcast</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="8" style="text-align:center;">Pendiente de generación...</td></tr>
                    </tbody>
                </table>
            </div>

            <label style="margin-top:15px; display:block;">Presupuesto y Licenciamiento Estimado (BOM):</label>
            <div id="bom-output" class="sub-panel" style="font-size:0.85rem; color:var(--text-main);">
                Pendiente de generación...
            </div>

            <div class="cli-header">
                <label style="margin:0;">Script CLI de Configuración:</label>
                <div>
                    <button type="button" class="btn btn-action btn-success" id="btn-copy" onclick="copyCliToClipboard()" disabled>Copiar</button>
                    <button type="button" class="btn btn-action" id="btn-download" onclick="downloadCliFile()" disabled style="background:#334155; color:#fff;">Descargar .txt</button>
                </div>
            </div>
            <pre id="cli-output">! Configure los parámetros y presione "Generar Script CLI & Plan IP"...</pre>
        </div>
    </div>

    <!-- SECCIÓN 2: TOPOLOGÍA DE RED E INTERCONEXIONES -->
    <div id="topology-tab" class="tab-content">
        <div class="card" style="grid-column: 1 / -1;">
            <h2>Topología de Equipos e Interconexiones Físicas</h2>
            
            <div class="grid-2" style="margin-bottom: 15px;">
                <div>
                    <label>Gestión de Archivos JSON:</label>
                    <div style="display:flex; gap:10px;">
                        <input type="file" id="topology-file" accept=".json" onchange="loadTopologyFromFile(event)">
                        <button type="button" class="btn btn-action btn-success" onclick="exportTopologyJSON()">Guardar/Exportar JSON</button>
                    </div>
                </div>
                <div style="text-align: right;">
                    <label>Acciones de Topología:</label>
                    <button type="button" class="btn btn-action" style="background:#38bdf8; color:#000;" onclick="openAddDeviceModal()">+ Agregar Dispositivo al Mapa</button>
                    <button type="button" class="btn btn-action btn-danger" onclick="clearTopology()">Limpiar Canvas</button>
                </div>
            </div>

            <div id="topology-canvas">
                <svg id="topo-svg" width="100%" height="100%">
                    <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#94a3b8">Agregue dispositivos o cargue un JSON para visualizar el diagrama</text>
                </svg>
            </div>

            <div style="margin-top:25px; background-color: var(--panel-bg); padding: 15px; border-radius: 8px; border: 2px solid var(--accent);">
                <h2 style="border: none; margin-bottom: 10px; color: #fff;">Agregar Conexión / Enlazar Dispositivos</h2>
                <div class="grid-4" style="align-items:end;">
                    <div class="form-group" style="margin:0;">
                        <label>Dispositivo Origen</label>
                        <select id="link-src-node" onchange="updateTopoPortSelectors()"></select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label>Puerto Origen</label>
                        <select id="link-src-port"></select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label>Dispositivo Destino</label>
                        <select id="link-dst-node" onchange="updateTopoPortSelectors()"></select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label>Puerto Destino</label>
                        <select id="link-dst-port"></select>
                    </div>
                </div>
                <button type="button" class="btn btn-success" style="margin-top:15px; font-size: 1rem;" onclick="createDeviceLink()">+ Agregar Conexión (Link)</button>
            </div>

            <div style="margin-top:20px;">
                <label>Enlaces Configurados:</label>
                <table id="links-summary-table">
                    <thead>
                        <tr>
                            <th>Origen (Puerto)</th>
                            <th>Destino (Puerto)</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="3" style="text-align:center;">Sin enlaces activos.</td></tr>
                    </tbody>
                </table>
            </div>
            
            <div style="margin-top:20px;">
                <label>Resumen de Nodos y Capacidad de Puertos:</label>
                <table id="nodes-summary-table">
                    <thead>
                        <tr>
                            <th>ID / Hostname</th>
                            <th>Tipo de Equipo</th>
                            <th>Capacidad Total</th>
                            <th>Puertos Ocupados</th>
                            <th>Puertos Disponibles</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="6" style="text-align:center;">Sin nodos configurados.</td></tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<div id="device-modal" class="modal-overlay hidden">
    <div class="modal-body">
        <h2 style="margin-bottom:15px;">Agregar Nuevo Dispositivo al Mapa</h2>
        <div class="form-group">
            <label>Nombre del Dispositivo (Hostname)</label>
            <input type="text" id="modal-dev-name" value="SW-ACCESO-01">
        </div>
        <div class="form-group">
            <label>Tipo de Dispositivo</label>
            <select id="modal-dev-type">
                <option value="Switch L2">Switch Capa 2</option>
                <option value="Switch L3">Switch Capa 3</option>
                <option value="Router WAN">Router WAN</option>
            </select>
        </div>
        <div class="form-group">
            <label>Puertos Totales (Capacidad Simétrica)</label>
            <input type="number" id="modal-dev-ports" value="24" min="1" max="96">
        </div>
        <div style="display:flex; gap:10px; margin-top:20px;">
            <button type="button" class="btn btn-success" style="margin:0;" onclick="confirmAddDevice()">Agregar</button>
            <button type="button" class="btn btn-danger" style="margin:0;" onclick="closeAddDeviceModal()">Cancelar</button>
        </div>
    </div>
</div>

<script>
    let activeTopology = {
        nodes: [
            { id: "RTR-01", name: "RTR-CORE-01", type: "Router WAN", maxPorts: 26, x: 150, y: 150, isLocal: true, portsList: [] }
        ],
        links: []
    };

    window.onload = function() {
        refreshAllInterfaceDropdowns();
        handleDeviceTypeChange();
        refreshVlanDropdowns();
        renderTopology();
    };

    function copyCliToClipboard() {
        const cliText = document.getElementById('cli-output').textContent;
        if (!cliText || cliText.startsWith("! Configure los parámetros") || cliText.startsWith("! Error")) {
            alert("No hay un script CLI válido para copiar.");
            return;
        }
        navigator.clipboard.writeText(cliText).then(() => {
            const copyBtn = document.getElementById('btn-copy');
            const originalText = copyBtn.textContent;
            copyBtn.textContent = "¡Copiado!";
            copyBtn.style.backgroundColor = "#0284c7";
            setTimeout(() => {
                copyBtn.textContent = originalText;
                copyBtn.style.backgroundColor = "";
            }, 2000);
        });
    }

    function switchTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById(tabId).classList.add('active');
        if(tabId === 'topology-tab') renderTopology();
    }

    function updateLocalNodeName() {
        const newName = document.getElementById('hostname').value;
        const localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.name = newName;
            renderTopology();
        }
    }

    function applyDeviceTypeToRow(row) {
        const devType = document.getElementById('device_type').value;
        const modeSel = row.querySelector('.if-mode');
        const optL3 = modeSel.querySelector('option[value="L3 Routed"]');
        const optAcc = modeSel.querySelector('option[value="Access"]');
        const optTrk = modeSel.querySelector('option[value="Trunk"]');
        
        if (devType === 'Router WAN') {
            if(optL3) { optL3.disabled = false; optL3.hidden = false; }
            if(optAcc) { optAcc.disabled = true; optAcc.hidden = true; }
            if(optTrk) { optTrk.disabled = true; optTrk.hidden = true; }
            modeSel.value = 'L3 Routed';
        } else if (devType === 'Switch L2') {
            if(optL3) { optL3.disabled = true; optL3.hidden = true; }
            if(optAcc) { optAcc.disabled = false; optAcc.hidden = false; }
            if(optTrk) { optTrk.disabled = false; optTrk.hidden = false; }
            if (modeSel.value === 'L3 Routed') modeSel.value = 'Access';
        } else { // Switch L3
            if(optL3) { optL3.disabled = false; optL3.hidden = false; }
            if(optAcc) { optAcc.disabled = false; optAcc.hidden = false; }
            if(optTrk) { optTrk.disabled = false; optTrk.hidden = false; }
        }
        handleIfRoleChange(modeSel);
    }

    function handleDeviceTypeChange() {
        const devType = document.getElementById('device_type').value;
        
        const switchModeCols = document.querySelectorAll('.col-switch-mode');
        const routerModeCols = document.querySelectorAll('.col-router-mode');
        const label = document.getElementById('vlan-section-label');
        
        const polOspf = document.querySelectorAll('.policy-ospf');
        const polVpn = document.querySelectorAll('.policy-vpn');
        const polDhcp = document.querySelectorAll('.policy-dhcp');
        const polDai = document.querySelectorAll('.policy-dai');

        if (devType === 'Router WAN') {
            switchModeCols.forEach(el => el.classList.add('hidden'));
            routerModeCols.forEach(el => el.classList.remove('hidden'));
            label.textContent = "Segmentación de VLANs y Creación de Subinterfaces Router (Dot1Q)";
            
            polOspf.forEach(el => el.classList.remove('hidden'));
            polVpn.forEach(el => el.classList.remove('hidden'));
            polDhcp.forEach(el => el.classList.add('hidden'));
            polDai.forEach(el => el.classList.add('hidden'));
        } else if (devType === 'Switch L2') {
            switchModeCols.forEach(el => el.classList.remove('hidden'));
            routerModeCols.forEach(el => el.classList.add('hidden'));
            label.textContent = "VLANs y Configuración de Interfaz Virtual SVI";
            
            polOspf.forEach(el => el.classList.add('hidden'));
            polVpn.forEach(el => el.classList.add('hidden'));
            polDhcp.forEach(el => el.classList.remove('hidden'));
            polDai.forEach(el => el.classList.remove('hidden'));
        } else { // Switch L3
            switchModeCols.forEach(el => el.classList.remove('hidden'));
            routerModeCols.forEach(el => el.classList.add('hidden'));
            label.textContent = "VLANs y Configuración de Interfaz Virtual SVI";
            
            polOspf.forEach(el => el.classList.remove('hidden'));
            polVpn.forEach(el => el.classList.remove('hidden'));
            polDhcp.forEach(el => el.classList.remove('hidden'));
            polDai.forEach(el => el.classList.remove('hidden'));
        }

        document.querySelectorAll('#interfaces-table tbody tr').forEach(row => {
            applyDeviceTypeToRow(row);
        });

        const localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.type = devType;
            if (document.getElementById('topology-tab').classList.contains('active')) renderTopology();
        }
        refreshAllInterfaceDropdowns();
    }

