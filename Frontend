    function confirmAddDevice() {
        const name = document.getElementById('modal-dev-name').value.trim();
        const type = document.getElementById('modal-dev-type').value;
        const maxPorts = parseInt(document.getElementById('modal-dev-ports').value) || 24;
        if (!name) return;
        const id = "DEV-" + Date.now(); 
        let portsList = generateDefaultPorts(maxPorts);
        activeTopology.nodes.push({ id, name, type, maxPorts, portsList, x: 100 + (activeTopology.nodes.length * 150) % 700, y: 150 + (activeTopology.nodes.length % 2) * 100 });
        closeAddDeviceModal();
        renderTopology();
