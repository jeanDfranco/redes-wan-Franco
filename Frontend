            availablePorts.forEach(p => select.innerHTML += `<option value="${p}">${p}</option>`);
            if (currentVal && availablePorts.includes(currentVal)) select.value = currentVal;
        });

        let localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.portsList = availablePorts;
            localNode.maxPorts = availablePorts.length;
        }
        if (document.getElementById('topology-tab').classList.contains('active')) renderTopology();
    }

