<script>
    let activeTopology = {
        nodes: [
            { id: "RTR-01", name: "RTR-CORE-01", type: "Router WAN", maxPorts: 26, x: 150, y: 150, isLocal: true, portsList: [] }
        ],
        links: []
    };

    function generateDefaultPorts(count) {
        let p = [];
        for(let i=1; i<=Math.min(count, 2); i++) p.push(`GigabitEthernet0/${i}`);
        for(let i=1; i<=Math.max(0, count-2); i++) p.push(`FastEthernet0/${i}`);
        return p;
    }

    window.onload = function() {
        refreshAllInterfaceDropdowns();
        handleDeviceTypeChange();
        refreshVlanDropdowns();
        renderTopology();
    };

    function switchTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById(tabId).classList.add('active');
        if(tabId === 'topology-tab') {
            renderTopology();
        }
    }

    function updateLocalNodeName() {
        const newName = document.getElementById('hostname').value;
        const localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.name = newName;
            renderTopology();
        }
    }

    function handleDeviceTypeChange() {
        const devType = document.getElementById('device_type').value;
        const switchModeCols = document.querySelectorAll('.col-switch-mode');
        const routerModeCols = document.querySelectorAll('.col-router-mode');
        const label = document.getElementById('vlan-section-label');

        if (devType === 'Router WAN') {
            switchModeCols.forEach(el => el.classList.add('hidden'));
            routerModeCols.forEach(el => el.classList.remove('hidden'));
            label.textContent = "Segmentación de VLANs y Creación de Subinterfaces Router (Dot1Q)";
        } else {
            switchModeCols.forEach(el => el.classList.remove('hidden'));
            routerModeCols.forEach(el => el.classList.add('hidden'));
            label.textContent = "VLANs y Configuración de Interfaz Virtual SVI";
        }

        const localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.type = devType;
            renderTopology();
        }
        refreshAllInterfaceDropdowns();
    }

    function toggleSviInput(checkbox) {
        checkbox.closest('tr').querySelector('.v-svi-ip').disabled = !checkbox.checked;
    }

    function toggleRouterSubintInputs(checkbox) {
        const row = checkbox.closest('tr');
        const enabled = checkbox.checked;
        row.querySelector('.r-parent-if').disabled = !enabled;
        row.querySelector('.r-sub-ip').disabled = !enabled;
    }

    function handleIfRoleChange(select) {
        const row = select.closest('tr');
        const ipInput = row.querySelector('.if-ip-field');
        const vlanSelect = row.querySelector('.if-vlan-field');
        if (select.value === 'L3 Routed') {
            ipInput.classList.remove('hidden');
            vlanSelect.classList.add('hidden');
        } else {
            ipInput.classList.add('hidden');
            vlanSelect.classList.remove('hidden');
        }
    }

    function getAllAvailablePorts() {
        let ports = [];
        const moduleRows = document.querySelectorAll('#hardware-modules-table tbody tr');
        
        moduleRows.forEach((row, modIndex) => {
            const ifType = row.querySelector('.mod-type').value;
            const count = parseInt(row.querySelector('.mod-count').value) || 0;
            const format = row.querySelector('.mod-format').value;

            for (let i = 1; i <= count; i++) {
                let portName = "";
                if (format === 'slot_0') portName = `${ifType}0/${i}`;
                else if (format === 'slot_0_0') portName = `${ifType}0/0/${i}`;
                else portName = `${ifType}0/${modIndex + 1}/${i}`;
                ports.push(portName);
            }
        });

        if (ports.length === 0) ports.push("GigabitEthernet0/1");
        return ports;
    }

    function refreshAllInterfaceDropdowns() {
        const availablePorts = getAllAvailablePorts();

        document.querySelectorAll('.if-name').forEach(select => {
            const currentVal = select.value;
            select.innerHTML = '';
            availablePorts.forEach(p => select.innerHTML += `<option value="${p}">${p}</option>`);
            if (currentVal && availablePorts.includes(currentVal)) select.value = currentVal;
        });

        document.querySelectorAll('.r-parent-if').forEach(select => {
            const currentVal = select.value;
            select.innerHTML = '';
            availablePorts.forEach(p => select.innerHTML += `<option value="${p}">${p}</option>`);
            if (currentVal && availablePorts.includes(currentVal)) select.value = currentVal;
        });

        // Actualizar el nodo principal (isLocal) en la topología
        let localNode = activeTopology.nodes.find(n => n.isLocal);
        if (localNode) {
            localNode.portsList = availablePorts;
            localNode.maxPorts = availablePorts.length;
        }
        
        if (document.getElementById('topology-tab').classList.contains('active')) {
            renderTopology();
        }
    }

    function addHardwareModuleRow() {
        const tbody = document.querySelectorAll('#hardware-modules-table tbody')[0];
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <select class="mod-type" onchange="refreshAllInterfaceDropdowns()">
                    <option value="GigabitEthernet">GigabitEthernet</option>
                    <option value="FastEthernet" selected>FastEthernet</option>
                    <option value="10GigabitEthernet">10GigabitEthernet</option>
                </select>
            </td>
            <td><input type="number" value="24" min="1" max="48" class="mod-count" onchange="refreshAllInterfaceDropdowns()"></td>
            <td>
                <select class="mod-format" onchange="refreshAllInterfaceDropdowns()">
                    <option value="slot_0">Slot Fijo / Base (0/X)</option>
                    <option value="slot_0_0">Slot Modular (0/0/X)</option>
                    <option value="slot_custom">Slot Tarjeta (0/Y/X)</option>
                </select>
            </td>
            <td><button type="button" class="btn-danger" onclick="removeModuleRow(this)">X</button></td>
        `;
        tbody.appendChild(row);
        refreshAllInterfaceDropdowns();
    }

    function removeModuleRow(btn) {
        const tbody = btn.closest('tbody');
        if (tbody.querySelectorAll('tr').length <= 1) {
            alert("El dispositivo debe mantener al menos un módulo de interfaz activo.");
            return;
        }
        btn.closest('tr').remove();
        refreshAllInterfaceDropdowns();
    }

    function refreshVlanDropdowns() {
        const vlans = [];
        document.querySelectorAll('#vlan-table tbody tr').forEach(row => {
            const id = row.querySelector('.v-id').value;
            const name = row.querySelector('.v-name').value;
            if (id) vlans.push({ id, name });
        });

        document.querySelectorAll('.if-vlan-field').forEach(select => {
            const curVal = select.value;
            select.innerHTML = '<option value="">Permitir Todas / Default</option>';
            vlans.forEach(v => select.innerHTML += `<option value="${v.id}">VLAN ${v.id} - ${v.name}</option>`);
            if (curVal) select.value = curVal;
        });
    }

    function addVlanRow() {
        const tbody = document.querySelectorAll('#vlan-table tbody')[0];
        const row = document.createElement('tr');
        const devType = document.getElementById('device_type').value;
        const hiddenClass = devType === 'Router WAN' ? '' : 'hidden';
        const switchHiddenClass = devType === 'Router WAN' ? 'hidden' : '';

        const availablePorts = getAllAvailablePorts();
        let portOptionsHtml = '';
        availablePorts.forEach(p => portOptionsHtml += `<option value="${p}">${p}</option>`);

        row.innerHTML = `
            <td><input type="number" value="20" class="v-id" onchange="refreshVlanDropdowns()"></td>
            <td><input type="text" value="NUEVA_VLAN" class="v-name" onchange="refreshVlanDropdowns()"></td>
            <td style="text-align:center;" class="col-switch-mode ${switchHiddenClass}"><input type="checkbox" class="v-svi-cb" onchange="toggleSviInput(this)"></td>
            <td class="col-switch-mode ${switchHiddenClass}"><input type="text" value="10.240.20.1/24" class="v-svi-ip" disabled></td>
            <td style="text-align:center;" class="col-router-mode ${hiddenClass}"><input type="checkbox" class="r-sub-cb" onchange="toggleRouterSubintInputs(this)" checked></td>
            <td class="col-router-mode ${hiddenClass}"><select class="r-parent-if">${portOptionsHtml}</select></td>
            <td class="col-router-mode ${hiddenClass}"><input type="text" value="10.240.20.1/24" class="r-sub-ip"></td>
            <td><button type="button" class="btn-danger" onclick="removeVlanRow(this)">X</button></td>
        `;
        tbody.appendChild(row);
        refreshVlanDropdowns();
    }

    function addInterfaceRow() {
        const tbody = document.querySelectorAll('#interfaces-table tbody')[0];
        const row = document.createElement('tr');
        
        const availablePorts = getAllAvailablePorts();
        let portOptionsHtml = '';
        availablePorts.forEach(p => portOptionsHtml += `<option value="${p}">${p}</option>`);

        row.innerHTML = `
            <td><select class="if-name">${portOptionsHtml}</select></td>
            <td>
                <select class="if-mode" onchange="handleIfRoleChange(this)">
                    <option value="L3 Routed">L3 Routed</option>
                    <option value="Access">Access (L2)</option>
                    <option value="Trunk">Trunk (L2)</option>
                </select>
            </td>
            <td>
                <input type="text" value="10.240.1.2/30" class="if-ip-field">
                <select class="if-vlan-field hidden"></select>
            </td>
            <td>
                <div class="checkbox-group" style="grid-template-columns:1fr 1fr;">
                    <label style="font-size:0.75rem;"><input type="checkbox" class="if-pf"> PortFast</label>
                    <label style="font-size:0.75rem;"><input type="checkbox" class="if-bpdu"> BPDUGuard</label>
                </div>
            </td>
            <td><button type="button" class="btn-danger" onclick="removeRow(this)">X</button></td>
        `;
        tbody.appendChild(row);
        refreshVlanDropdowns();
